# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~

# Python
__pycache__/
*.pyc

# Local editor state, including task files generated at runtime by the launcher
.vscode/

# Packaged Comate bridge extension artifact (regenerated by
# scripts/package-comate-bridge.py; not committed)
/dist/

# Generated VSCode workspace overwritten on every launch by
# launch_vscode_new_window() (resume-sessions.sh); contains local
# absolute paths, never secrets, but is a machine-specific build artifact.
/resume-sessions.code-workspace
